# Local lab configuration. Copy to .env and replace every value; never commit .env.

LAB_ENV=local

POSTGRES_DB=security_lab
POSTGRES_USER=security_lab
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5432

DATABASE_URL=postgresql://security_lab:replace-with-local-password@localhost:5432/security_lab
TEST_DATABASE_URL=postgresql://security_lab:replace-with-local-password@localhost:5432/security_lab_test

# Trusted collector credential for POST /internal/events/batch only. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
COLLECTOR_TOKEN=

# Application sessions (users and the lab analyst) log in through POST /auth/login.
SESSION_LIFETIME_MINUTES=480

# Shared password (12+ characters) for every seeded fictional user. Read by scripts.seed
# (which prompts if unset) and by scripts.generate_scenarios (which requires it).
SEED_USER_PASSWORD=

# Read-only export uses a separately generated database-backed credential.
# See docs/hardening_section6.md; export EVENT_EXPORT_TOKEN from its private token file.
# This is not COLLECTOR_TOKEN and is never an analyst session.

API_URL=http://127.0.0.1:8000
